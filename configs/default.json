{
  "data": {
    "train": "data/raw/train.csv",
    "target": "Heart Disease",
    "id": "id"
  },
  "seed": 42,
  "holdout_fraction": 0.2,
  "folds": 3,
  "threshold": 0.5,
  "selection_metric": "roc_auc",
  "positive_label": "Presence",
  "negative_label": "Absence",
  "numeric_features": [
    "Age",
    "Cholesterol",
    "Max HR",
    "ST depression",
    "Number of vessels fluro"
  ],
  "categorical_features": [
    "Sex",
    "Chest pain type",
    "EKG results",
    "Exercise angina",
    "Slope of ST",
    "Thallium"
  ],
  "models": {
    "decision_tree": {
      "criterion": "gini",
      "max_depth": 8,
      "min_samples_leaf": 50
    },
    "adaboost": {
      "n_estimators": 50,
      "learning_rate": 1.0
    },
    "random_forest": {
      "n_estimators": 100,
      "max_depth": 12,
      "min_samples_leaf": 50,
      "max_features": "sqrt",
      "n_jobs": 1
    },
    "logistic": {
      "C": 1.0,
      "max_iter": 1000
    }
  },
  "threads": 1,
  "splits_dir": "data/splits"
}
